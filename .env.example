# ============================================
# Job Application Tracker - Environment Variables
# ============================================
# Copy this file to `.env` and update the values.
# These are read by docker-compose.yml and passed into the app container.

# PostgreSQL password (used by both postgres and app services)
POSTGRES_PASSWORD=password123

# HTTP Basic Auth credentials (recommended - protects your data)
# Leave blank to disable authentication
AUTH_USERNAME=
AUTH_PASSWORD=
